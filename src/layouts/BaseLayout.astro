---
import '../styles/global.css';
import type { Locale } from '../i18n/content';
import WebMCPTools from '../components/WebMCPTools.astro';
interface Props { lang: Locale; title: string; description: string; }
const { lang, title, description } = Astro.props;
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10161d" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="pt-BR" href="/pt-BR/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <title>{title}</title>
  </head>
  <body><slot /><WebMCPTools lang={lang} /></body>
</html>
