---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProtocolDiagram from '../../components/ProtocolDiagram.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { copy, locales, type Locale } from '../../i18n/content';

export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = copy[lang] ?? copy.en;
const roadmap = [
  ['01', 'Protocol Foundation', t.current],
  ['02', 'P2P Trading SDK', t.current],
  ['03', 'Open Market Coordination', t.development],
  ['04', 'Portable Identity & Reputation', t.development],
  ['05', 'Open Agents', t.demonstrated],
  ['06', 'Expanded SDK Family', t.direction],
];
---
<BaseLayout lang={lang} title={`${t.title} | ${t.protocolDescriptor}`} description={t.bigIdea}>
  <SiteHeader lang={lang} />

  <main>
    <section class="hero" id="protocol">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}<em>{t.protocolDescriptor}</em></h1>
        <p class="lead">{t.bigIdea}</p>
        <p>{t.hero}</p>
        <div class="actions"><a href={`/${lang}/sdks/p2p-trading/`}>{t.heroPrimaryCta} ↗</a><a href="#anatomy">{t.heroSecondaryCta} ↓</a></div>
      </div>
      <div class="market-orbit" aria-label={t.heroDiagramLabel}>
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <circle class="ring r1" cx="300" cy="300" r="220"/><ellipse class="ring r2" cx="300" cy="300" rx="245" ry="120"/><ellipse class="ring r3" cx="300" cy="300" rx="125" ry="250"/>
          <path class="route" d="M105 190C220 50 390 70 495 185S520 430 390 505 125 460 100 315 170 170 300 300 460 410 495 185"/>
          <circle class="packet packet-orange" r="7"><animateMotion dur="8s" repeatCount="indefinite" path="M105 190C220 50 390 70 495 185S520 430 390 505 125 460 100 315 170 170 300 300 460 410 495 185"/></circle>
          <circle class="packet packet-blue" r="6"><animateMotion dur="10s" begin="-2s" repeatCount="indefinite" path="M495 185C390 70 220 50 105 190S80 430 210 505 475 460 500 315 430 170 300 300 140 410 105 190"/></circle>
          <circle class="packet packet-green" r="5"><animateMotion dur="12s" begin="-5s" repeatCount="indefinite" path="M300 50C470 80 520 230 440 350S210 530 120 400 110 130 300 50"/></circle>
          <circle class="packet packet-violet" r="5"><animateMotion dur="9s" begin="-4s" repeatCount="indefinite" path="M90 300C130 120 350 80 500 210S480 500 300 520 70 450 90 300"/></circle>
          <circle class="packet packet-white" r="4"><animateMotion dur="7s" begin="-3s" repeatCount="indefinite" path="M300 90C190 140 170 330 300 510 430 330 410 140 300 90"/></circle>
        </svg>
        <div class="sails-core"><span class="mark"><i></i><i></i></span><b>SAILS</b><small>{t.heroSemantics}</small></div>
        <span class="node n1">{t.heroNodes[0]}</span><span class="node n2">{t.heroNodes[1]}</span><span class="node n3">{t.heroNodes[2]}</span><span class="node n4">{t.heroNodes[3]}</span>
      </div>
      <div class="manifest"><span>{t.manifest[0]}</span><span>{t.manifest[1]}</span><span>{t.manifest[2]}</span><strong>{t.mantra}</strong></div>
    </section>

    <section class="problem">
      <p class="eyebrow">01 / {t.problemLabel}</p>
      <div class="split"><h2>{t.problemTitle}</h2><div><p>{t.problem}</p><strong>{t.coordination}</strong></div></div>
      <div class="market-islands" role="img" aria-label={t.islandsLabel}>
        {t.islandNames.map((name, index) => <article>
          <div><span>0{index + 1}</span><b>{name}</b><i aria-hidden="true"></i></div>
          <div class="island-surfaces">{t.islandSurfaces.map(surface => <small>{surface}</small>)}</div>
        </article>)}
      </div>
      <p class="islands-caption">{t.islandsLabel}</p>
      <blockquote>{t.problemQuote[0]}<br/><em>{t.problemQuote[1]}</em></blockquote>
    </section>

    <section class="market-participation">
      <div class="participation-copy"><p class="eyebrow">02 / {t.solutionLabel}</p><h2>{t.solutionTitle}</h2><p>{t.solutionText}</p></div>
      <div class="participation-visual" role="img" aria-label={t.solutionDiagramLabel}>
        <div class="open-core"><b>{t.solutionCore}</b><div>{t.solutionSemantics.map(item => <small>{item}</small>)}</div></div>
        {t.solutionParticipants.map((name,index) => <span class={`p${index + 1}`}>{name}</span>)}
        <svg viewBox="0 0 600 480" aria-hidden="true"><circle cx="300" cy="240" r="165"/><path d="M300 45V170M520 160 385 215M300 435V310M80 320 215 265"/></svg>
      </div>
      <p class="coordination-boundary">{t.solutionBoundary}</p>
      <div class="participation-rule"><span>{t.solutionRule[0]}</span><strong>{t.solutionRule[1]}</strong></div>
    </section>

    <section class="anatomy" id="anatomy">
      <div class="section-copy"><p class="eyebrow">03 / {t.anatomyLabel}</p><h2>{t.anatomyTitle}</h2><p>{t.anatomyText}</p><ul class="anatomy-principles">{t.anatomyPrinciples.map(item => <li>{item}</li>)}</ul><a href={`/${lang}/anatomy/`}>{t.anatomyLink} →</a></div>
      <ProtocolDiagram lang={lang} />
    </section>

    <section class="sdks" id="sdks">
      <p class="eyebrow">04 / {t.sdkLabel}</p><div class="split"><h2>{t.sdkTitle}</h2><p>{t.sdkText}</p></div>
      <div class="current-sdk">
        <div class="sdk-product-copy">
          <div class="sdk-status-row"><span>{t.sdkStatus}</span><small>{t.sdkPackageLabel}</small></div>
          <code>@satsails/p2p-trading-sdk</code>
          <p class="sdk-list-label">{t.sdkCapabilitiesLabel}</p>
          <ol>{t.sdkCapabilities.map((item,index) => <li><span>0{index + 1}</span>{item}</li>)}</ol>
          <p class="sdk-list-label">{t.sdkControlLabel}</p>
          <div class="sdk-controls">{t.sdkControls.map(item => <span>✓ {item}</span>)}</div>
          <div class="sdk-actions"><a href={`/${lang}/sdks/p2p-trading/`}>{t.sdkCta} →</a><a href={`/${lang}/developers/documentation/`}>{t.sdkDocs}</a><a href="https://github.com/alan-schramm/Sails-Protocol">{t.sdkSource} ↗</a></div>
        </div>
        <div class="p2p-product-flow" role="img" aria-label={t.sdkFlowLabel}>
          <div class="flow-sources">{t.sdkFlowSources.map((item,index) => <span><small>0{index + 1}</small>{item}</span>)}</div>
          <div class="flow-connector" aria-hidden="true">→</div>
          <div class="flow-sdk"><small>SAILS</small><b>{t.sdkFlowCore}</b><div>{t.sdkFlowSteps.map(item => <span>{item}</span>)}</div></div>
          <div class="flow-connector" aria-hidden="true">→</div>
          <div class="flow-execution"><span>{t.sdkFlowTarget}</span>{t.sdkFlowRails.map(item => <small><b>{item[0]}</b><i>{item[1]}</i></small>)}</div>
        </div>
      </div>
    </section>

    <section class="modules-family" id="modules">
      <div class="modules-intro"><p class="eyebrow">05 / {t.compositionLabel}</p><h2>{t.compositionTitle}</h2><p>{t.compositionText}</p></div>
      <div class="composition-flow">{t.compositionFlow.map((item,index) => <><article><span>0{index + 1}</span><b>{item[0]}</b><small>{item[1]}</small></article>{index < t.compositionFlow.length - 1 && <i aria-hidden="true">↓</i>}</>)}</div>
      <p class="family-label">{t.modulesLabel}</p>
      <div class="module-family-grid">{t.modules.map((m,i)=><article class:list={{primary:i===0}}><span>0{i+1}</span><small>{m[2]}</small><i class="module-icon" aria-hidden="true">{m[3]}</i><h3>{m[0]}</h3><p>{m[1]}</p></article>)}</div>
      <div class="family-lanes">
        <div><p class="family-label">{t.sdkFamilyLabel}</p><div class="sdk-family-row">{t.sdkFamily.map((item,index) => <article class:list={{current:index===0}}><b>{item[0]}</b><small>{item[1]}</small></article>)}</div></div>
        <div><p class="family-label">{t.implementationLabel}</p><div class="implementation-row">{t.implementations.map((item,index) => <article class:list={{first:index===0}}><b>{item[0]}</b><small>{item[1]}</small></article>)}</div></div>
      </div>
      <p class="composition-principle">{t.compositionPrinciple}</p>
      <div class="module-rule">{t.compositionRule.map((item,index) => <><span>{item}</span>{index < t.compositionRule.length - 1 && <b>≠</b>}</>)}</div>
    </section>

    <section class="evidence-section" id="evidence">
      <div class="evidence-intro"><p class="eyebrow">06 / {t.evidenceLabel}</p><h2>{t.evidenceTitle}</h2><p>{t.evidenceText}</p></div>
      <div class="evidence-cards">{t.evidenceCards.map((item,index) => <article>
        <div><span>0{index + 1}</span><small>{item[1]}</small></div><strong>{item[2]}</strong><h3>{item[0]}</h3><p>{item[3]}</p>
      </article>)}</div>
      <p class="family-label">{t.evidenceDirectionsLabel}</p>
      <div class="evidence-directions">{t.evidenceDirections.map(item => <article><b>{item[0]}</b><small>{item[1]}</small></article>)}</div>
      <div class="evidence-footer"><p>{t.evidenceBoundary}</p><a href={`/${lang}/integrations/`}>{t.evidenceCta} →</a></div>
    </section>

    <section class="reference-cases" id="case-studies">
      <div class="cases-intro"><p class="eyebrow">07 / {t.casesLabel}</p><h2>{t.casesTitle}</h2><p>{t.casesText}</p></div>
      <div class="case-grid">{t.cases.map((item,index) => <article>
        <div class:list={['case-visual', `case-visual-${index + 1}`]} aria-hidden="true">
          <div class="case-window"><span></span><span></span><span></span></div>
          <div class="case-mark"><i></i><i></i></div>
          <div class="case-lines"><span></span><span></span><span></span></div>
          <div class="case-flow"><i></i><i></i><i></i></div>
        </div>
        <div class="case-copy"><div><span>0{index + 1}</span><small>{item[1]}</small></div><h3>{item[0]}</h3><p>{item[2]}</p><ul>{item[3].map(point => <li>✓ {point}</li>)}</ul></div>
      </article>)}</div>
      <div class="cases-footer"><strong>{t.casesBoundary}</strong><a href={`/${lang}/case-studies/`}>{t.casesCta} →</a></div>
    </section>

    <section class="interfaces-section" id="interfaces">
      <div class="interfaces-intro"><p class="eyebrow">08 / {t.interfacesLabel}</p><h2>{t.interfacesTitle}</h2><p>{t.interfacesText}</p></div>
      <div class="interface-groups">
        <div><p class="family-label">{t.currentInterfacesLabel}</p><div class="interface-cards current-interfaces">{t.currentInterfaces.map((item,index) => <article><span>0{index + 1}</span><b>{item[0]}</b><small>{item[1]}</small></article>)}</div></div>
        <div><p class="family-label">{t.evolvingInterfacesLabel}</p><div class="interface-cards evolving-interfaces">{t.evolvingInterfaces.map((item,index) => <article><span>0{index + 1}</span><b>{item[0]}</b><small>{item[1]}</small></article>)}</div></div>
      </div>
      <p class="agent-principle">{t.agentPrinciple}</p>
      <div class="ai-explore" aria-labelledby="ai-title">
        <div><p class="eyebrow">{t.aiLabel}</p><h3 id="ai-title">{t.aiTitle}</h3><p>{t.aiText}</p><a href={`/${lang}/developers/`}>{t.interfacesCta} →</a></div>
        <div class="ai-tools">{[['claude','Claude'],['codex','Codex'],['gemini','Gemini'],['grok','Grok']].map(([icon,name])=><a href={`/${lang}/explore-ai/`}><span class="ai-logo-frame"><img class={`ai-logo-${icon}`} src={`/logos/${icon}.svg`} alt=""/></span><b>{name}</b><span class="ai-status">{t.aiStatus}</span></a>)}</div>
      </div>
    </section>

    <section class="node-offer">
      <div class="node-offer-copy"><p class="eyebrow">SAILS NODE</p><h2>{lang==='pt-BR'?'Participe da infraestrutura. Opere um node com a sua própria identidade.':lang==='es'?'Participa en la infraestructura. Opera un nodo con tu propia identidad.':'Participate in the infrastructure. Operate a node with your own identity.'}</h2><p>{lang==='pt-BR'?'Um Sails Node permite que organizações operem capacidades, conectem provedores e participem da coordenação aberta sob limites explícitos. Escolha hospedar sua própria infraestrutura, usar uma operação gerenciada ou lançar uma experiência white-label.':lang==='es'?'Un Sails Node permite que organizaciones operen capacidades, conecten proveedores y participen en la coordinación abierta bajo límites explícitos. Elige alojar tu propia infraestructura, usar una operación administrada o lanzar una experiencia white-label.':'A Sails Node lets organizations operate capabilities, connect providers and participate in open coordination under explicit boundaries. Choose to host your own infrastructure, use a managed operation or launch a white-label experience.'}</p><div class="actions"><a href={`/${lang}/portal/login/`}>Get started</a><a href={`/${lang}/products/sails-node/`}>{lang==='pt-BR'?'Explorar Sails Node':lang==='es'?'Explorar Sails Node':'Explore Sails Node'} →</a></div></div>
      <div><div class="node-paths"><article><span>01</span><small>SELF-HOSTED</small><h3>{lang==='pt-BR'?'Seu node, sua infraestrutura':lang==='es'?'Tu nodo, tu infraestructura':'Your node, your infrastructure'}</h3><p>{lang==='pt-BR'?'Execute onde preferir e mantenha controle operacional.':lang==='es'?'Ejecuta donde prefieras y conserva el control operativo.':'Run it where you choose and retain operational control.'}</p></article><article><span>02</span><small>MANAGED</small><h3>{lang==='pt-BR'?'Operação assistida':lang==='es'?'Operación asistida':'Assisted operation'}</h3><p>{lang==='pt-BR'?'Configure capacidades com suporte de implantação e observabilidade.':lang==='es'?'Configura capacidades con soporte de implementación y observabilidad.':'Configure capabilities with deployment and observability support.'}</p></article><article><span>03</span><small>WHITE-LABEL</small><h3>{lang==='pt-BR'?'Sua marca sobre Sails':lang==='es'?'Tu marca sobre Sails':'Your brand on Sails'}</h3><p>{lang==='pt-BR'?'Uma experiência configurável para produtos e operações próprias.':lang==='es'?'Una experiencia configurable para productos y operaciones propias.':'A configurable experience for your own products and operations.'}</p></article></div><div class="node-benefits">{(lang==='pt-BR'?['Escolha de infraestrutura','Capacidades modulares','Identidade própria','Observabilidade operacional']:lang==='es'?['Elección de infraestructura','Capacidades modulares','Identidad propia','Observabilidad operativa']:['Infrastructure choice','Modular capabilities','Your own identity','Operational observability']).map(item=><span>✓ {item}</span>)}</div></div>
    </section>

    <section class="roadmap" id="roadmap">
      <p class="eyebrow">05 / {t.roadmapLabel}</p><h2>{t.roadmapTitle}</h2><div class="status-key"><span>{t.current}</span><span>{t.demonstrated}</span><span>{t.development}</span><span>{t.direction}</span></div>
      <div class="roadmap-line">{roadmap.map((item, i) => <article class:list={{ live: i < 2 }}><span>{item[0]}</span><div><h3>{item[1]}</h3><small>{item[2]}</small></div></article>)}</div>
      <p class="reality">{t.reality}. <strong>The roadmap expands capabilities without changing the meaning of the protocol.</strong></p><a class="more-link" href={`/${lang}/roadmap/`}>{lang==='pt-BR'?'Ver roadmap completo':lang==='es'?'Ver roadmap completo':'View full roadmap'} →</a>
    </section>
  </main>
  <SiteFooter description={t.bigIdea} />
</BaseLayout>
