---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/content';
interface Card { title: string; text: string; status?: string }
interface Props { lang: Locale; eyebrow: string; title: string; intro: string; cards: Card[]; statement: string; diagram?: 'flow'|'kernel'|'sdk'|'network'; }
const { lang, eyebrow, title, intro, cards, statement, diagram='flow' } = Astro.props;
const nav = lang === 'pt-BR' ? ['Protocolo','Anatomia','SDKs','Roadmap'] : lang === 'es' ? ['Protocolo','Anatomía','SDKs','Roadmap'] : ['Protocol','Anatomy','SDKs','Roadmap'];
---
<BaseLayout lang={lang} title={`${title} — Sails Protocol`} description={intro}>
  <header class="glass-nav">
    <a class="brand" href={`/${lang}/`}><span class="mark"><i></i><i></i></span><b>SAILS</b><small>PROTOCOL</small></a>
    <nav><a href={`/${lang}/protocol/`}>{nav[0]}</a><a href={`/${lang}/anatomy/`}>{nav[1]}</a><a href={`/${lang}/sdks/`}>{nav[2]}</a><a href={`/${lang}/roadmap/`}>{nav[3]}</a></nav>
    <div class="nav-actions"><div class="locale"><a href={`/en/${Astro.url.pathname.split('/').slice(2).join('/')}`}>EN</a><a class:list={{active:lang==='pt-BR'}} href={`/pt-BR/${Astro.url.pathname.split('/').slice(2).join('/')}`}>PT</a><a href={`/es/${Astro.url.pathname.split('/').slice(2).join('/')}`}>ES</a></div><a class="github" href="https://github.com/sails-protocol/sails-protocol-website">GitHub ↗</a></div>
  </header>
  <main class="inner">
    <section class="inner-hero"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{intro}</p></section>
    <section class={`inner-diagram ${diagram}`} aria-label={`${title} visual model`}>
      <div class="diagram-center"><span class="mark"><i></i><i></i></span><b>SAILS</b><small>economic semantics</small></div>
      {cards.slice(0,4).map((card,i)=><article class={`visual-card v${i+1}`}><span>0{i+1}</span><b>{card.title}</b><small>{card.status ?? 'PROTOCOL LAYER'}</small></article>)}
      <svg viewBox="0 0 1000 560" aria-hidden="true"><path d="M190 120C350 120 340 280 500 280"/><path d="M810 120C650 120 660 280 500 280"/><path d="M190 440C350 440 340 280 500 280"/><path d="M810 440C650 440 660 280 500 280"/></svg>
    </section>
    <section class="inner-grid">{cards.map((card,i)=><article><span>0{i+1}</span>{card.status&&<small>{card.status}</small>}<h2>{card.title}</h2><p>{card.text}</p></article>)}</section>
    <section class="inner-statement"><p>{statement}</p><a href={`/${lang}/`}>← Sails Protocol</a></section>
  </main>
  <footer><b>SAILS PROTOCOL</b><p>Economic Coordination Protocol for building interoperable P2P financial marketplaces.</p><span>Built by the Satsails team</span></footer>
</BaseLayout>
