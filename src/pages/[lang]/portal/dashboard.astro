---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../../i18n/content';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}))}
const lang=Astro.params.lang as Locale;
const t = lang==='pt-BR'
  ? {overview:'Visão geral',welcome:'Preview do futuro ambiente operacional.',text:'Uma demonstração visual de como capacidades, Open Extensions e opções de Sails Node poderão ser organizadas. Nenhuma função operacional está ativa.',preview:'PREVIEW DE INTERFACE',notice:'Sem autenticação, analytics reais ou provisionamento de infraestrutura.',extensions:'Domínios de capacidade',node:'Modelos de operação propostos',docs:'Documentação',analytics:'Analytics',settings:'Configurações',team:'Equipe',self:'Operação independente',managed:'Node gerenciado',white:'Ambiente white-label',current:'CAMINHO DOCUMENTADO',direction:'DIREÇÃO',concept:'CONCEITO COMERCIAL',site:'Ver site',compose:'Organize capacidades por contratos explícitos.',choose:'Compare possibilidades sem iniciar provisionamento.',local:'Use apenas os caminhos locais ou de servidor documentados no repositório.',managedText:'Operação assistida e observabilidade permanecem como direção futura.',whiteText:'Ambiente personalizado e operação gerenciada ainda são um conceito comercial.',portal:'PROTÓTIPO DO PORTAL',account:'SEM CONTA',authentication:'AUTENTICAÇÃO',off:'DESATIVADA',prototypeOnly:'Somente protótipo',openExtensions:'OPEN EXTENSIONS',capabilityDomains:'Domínios de capacidade',provisionedNodes:'NODES PROVISIONADOS',noProvisioning:'Sem provisionamento ativo'}
  : lang==='es'
  ? {overview:'Visión general',welcome:'Preview del futuro entorno operativo.',text:'Una demostración visual de cómo podrían organizarse capacidades, Open Extensions y opciones de Sails Node. Ninguna función operativa está activa.',preview:'PREVIEW DE INTERFAZ',notice:'Sin autenticación, analytics reales ni aprovisionamiento de infraestructura.',extensions:'Dominios de capacidad',node:'Modelos de operación propuestos',docs:'Documentación',analytics:'Analytics',settings:'Configuración',team:'Equipo',self:'Operación independiente',managed:'Nodo administrado',white:'Entorno white-label',current:'RUTA DOCUMENTADA',direction:'DIRECCIÓN',concept:'CONCEPTO COMERCIAL',site:'Ver sitio',compose:'Organiza capacidades mediante contratos explícitos.',choose:'Compara posibilidades sin iniciar aprovisionamiento.',local:'Usa solamente las rutas locales o de servidor documentadas en el repositorio.',managedText:'La operación asistida y la observabilidad siguen como dirección futura.',whiteText:'El entorno personalizado y la operación administrada aún son un concepto comercial.',portal:'PROTOTIPO DEL PORTAL',account:'SIN CUENTA',authentication:'AUTENTICACIÓN',off:'DESACTIVADA',prototypeOnly:'Solo prototipo',openExtensions:'OPEN EXTENSIONS',capabilityDomains:'Dominios de capacidad',provisionedNodes:'NODOS APROVISIONADOS',noProvisioning:'Sin aprovisionamiento activo'}
  : {overview:'Overview',welcome:'Preview the future operating environment.',text:'A visual demonstration of how capabilities, Open Extensions and Sails Node options may be organized. No operational function is active.',preview:'INTERFACE PREVIEW',notice:'No authentication, live analytics or infrastructure provisioning.',extensions:'Capability domains',node:'Proposed operating models',docs:'Documentation',analytics:'Analytics',settings:'Settings',team:'Team',self:'Independent operation',managed:'Managed node',white:'White-label environment',current:'DOCUMENTED PATH',direction:'DIRECTION',concept:'COMMERCIAL CONCEPT',site:'View website',compose:'Organize capabilities through explicit contracts.',choose:'Compare possibilities without starting provisioning.',local:'Use only local or server paths documented by the repository.',managedText:'Guided operation and observability remain a future direction.',whiteText:'A branded environment and managed operation remain a commercial concept.',portal:'PORTAL PROTOTYPE',account:'NO ACCOUNT',authentication:'AUTHENTICATION',off:'OFF',prototypeOnly:'Prototype only',openExtensions:'OPEN EXTENSIONS',capabilityDomains:'Capability domains',provisionedNodes:'PROVISIONED NODES',noProvisioning:'No active provisioning'};
const menu=[['⌂',t.overview],['◇',t.extensions],['◎',t.node],['≡',t.docs],['⌁',t.analytics],['⚙',t.settings],['＋',t.team]];
const extensions=[['OpenP2P',t.current],['OpenSettlement',t.direction],['OpenIdentity',t.direction],['OpenReputation',t.direction]];
---
<BaseLayout lang={lang} title={`${t.preview} | Sails Portal`} description={t.text}>
  <main class="portal-shell">
    <aside class="portal-sidebar"><a class="portal-brand" href={`/${lang}/`}><img src="/brand/sails-protocol-horizontal-cor-escuro.svg" alt="Sails Protocol" /></a><nav>{menu.map(([icon,label],i)=><span class:list={['portal-nav-item',{active:i===0}]}><i>{icon}</i>{label}</span>)}</nav><div class="portal-user"><i>PX</i><div><b>{t.preview}</b><small>{t.account}</small></div></div></aside>
    <section class="portal-main">
      <div class="portal-preview-banner"><b>{t.preview}</b><span>{t.notice}</span></div>
      <header><div><small>SAILS PORTAL / {t.overview.toUpperCase()}</small><h1>{t.welcome}</h1><p>{t.text}</p></div><a href={`/${lang}/`}>{t.site} ↗</a></header>
      <div class="portal-stats"><article><small>{t.authentication}</small><b>{t.off}</b><span>{t.prototypeOnly}</span></article><article><small>{t.openExtensions}</small><b>08</b><span>{t.capabilityDomains}</span></article><article><small>{t.provisionedNodes}</small><b>00</b><span>{t.noProvisioning}</span></article></div>
      <section class="portal-panel"><div><p class="eyebrow">{t.extensions}</p><h2>{t.compose}</h2></div><div class="extension-list">{extensions.map(([name,status],i)=><article><span>0{i+1}</span><b>{name}</b><small>{status}</small></article>)}</div></section>
      <section class="portal-panel node-config"><div><p class="eyebrow">{t.node}</p><h2>{t.choose}</h2></div><div class="node-choice"><article><small>{t.current}</small><b>{t.self}</b><span>{t.local}</span></article><article><small>{t.direction}</small><b>{t.managed}</b><span>{t.managedText}</span></article><article><small>{t.concept}</small><b>{t.white}</b><span>{t.whiteText}</span></article></div></section>
    </section>
  </main>
</BaseLayout>
