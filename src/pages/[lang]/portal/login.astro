---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { locales, type Locale } from '../../../i18n/content';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}))}
const lang=Astro.params.lang as Locale;
const t = lang==='pt-BR'
  ? {eyebrow:'PROTÓTIPO DO PORTAL',title:'Visualize o futuro ambiente operacional.',text:'Este preview mostra como Open Extensions, Sails Nodes e espaços de equipe poderão ser organizados. Nenhuma conta, autenticação ou infraestrutura é criada.',google:'Login com Google planejado',github:'Login com GitHub planejado',note:'Preview de interface. Autenticação, contas, analytics e provisionamento de nodes não estão ativos.',preview:'Abrir preview do ambiente',terms:'Nenhum dado de login é solicitado ou processado nesta demonstração.',brand:'PROTÓTIPO DO PORTAL'}
  : lang==='es'
  ? {eyebrow:'PROTOTIPO DEL PORTAL',title:'Visualiza el futuro entorno operativo.',text:'Este preview muestra cómo podrían organizarse Open Extensions, Sails Nodes y espacios de equipo. No se crea ninguna cuenta, autenticación o infraestructura.',google:'Login con Google planificado',github:'Login con GitHub planificado',note:'Preview de interfaz. La autenticación, las cuentas, analytics y el aprovisionamiento de nodos no están activos.',preview:'Abrir preview del entorno',terms:'No se solicitan ni procesan datos de acceso en esta demostración.',brand:'PROTOTIPO DEL PORTAL'}
  : {eyebrow:'PORTAL PROTOTYPE',title:'Preview the future operating environment.',text:'This preview shows how Open Extensions, Sails Nodes and team workspaces may be organized. No account, authentication or infrastructure is created.',google:'Google login planned',github:'GitHub login planned',note:'Interface preview. Authentication, accounts, analytics and node provisioning are not active.',preview:'Open environment preview',terms:'No login data is requested or processed in this demonstration.',brand:'PORTAL PROTOTYPE'};
---
<BaseLayout lang={lang} title={`${t.title} | Sails Portal`} description={t.text}>
  <SiteHeader lang={lang} path="portal/login" />
  <main class="portal-login"><section class="login-intro"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p>{t.text}</p><div class="portal-capabilities"><span>OPEN EXTENSION</span><span>SAILS NODE</span><span>ANALYTICS</span><span>TEAM</span></div></section><section class="login-card"><div class="login-brand"><img src="/brand/sails-protocol-horizontal-cor-escuro.svg" alt="Sails Protocol" /></div><h2>{t.eyebrow}</h2><p>{t.text}</p><button class="oauth google" type="button" disabled aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.3c1.9-1.8 2.9-4.4 2.9-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.5c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.5 14a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9.1L6.5 14Z"/><path fill="#EA4335" d="M12 6.1c1.5 0 2.8.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 3.1 7.5l3.4 2.7A5.9 5.9 0 0 1 12 6.1Z"/></svg>{t.google}</button><button class="oauth github-oauth" type="button" disabled aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z"/></svg>{t.github}</button><a class="preview-entry" href={`/${lang}/portal/dashboard/`}>{t.preview} →</a><div class="auth-status"><i></i><span>{t.note}</span></div><small class="login-terms">{t.terms}</small></section></main>
  <SiteFooter />
</BaseLayout>
