---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import type { Locale } from '../i18n/content';
interface Props { lang: Locale }
const { lang } = Astro.props;
const github = 'https://github.com/alan-schramm/Sails-Protocol';
const c = {
  en: {
    eyebrow:'FIRST DEVELOPER PRODUCT',status:'CURRENT',package:'PACKAGE',title:'Sails P2P Trading SDK',intro:'Add interoperable P2P market coordination to a wallet, fintech or web platform while preserving its keys, signing stack, settlement choices and user experience.',docs:'Read documentation',source:'View source',problemLabel:'THE MARKET PROBLEM',problem:'Open custody does not create an open market.',problemText:'Keys may be portable while offers, counterparties, negotiation and economic history remain confined to each application. Every product then rebuilds discovery, messaging, evidence and settlement coordination around its own private market.',isolated:'ISOLATED MARKET',surfaces:['WALLET MARKET','FINTECH MARKET','WEB MARKET'],shiftLabel:'WHAT CHANGES',shift:'From a private feature to a shared coordination surface.',shiftText:'The SDK gives applications common economic semantics for expressing intent, discovering compatible opportunities, negotiating terms and coordinating settlement outside the protocol. Each participant declares what it actually supports.',flowLabel:'COORDINATION FLOW',visualTitle:'One SDK. Six explicit coordination stages.',visualText:'Sails coordinates the agreement lifecycle. Wallets and providers keep custody, signing and execution.',entries:['Wallet','Fintech','Web platform'],stages:['Express intent','Discover opportunities','Negotiate terms','Match capabilities','Coordinate settlement','Record outcomes'],demonstrated:'DEMONSTRATED',direction:'DIRECTION',rails:[['Bitcoin multisig','DEMONSTRATED'],['WDK USDT EVM','DEMONSTRATED'],['Arkade / VTXO','DEMONSTRATED'],['Lightning','INDEPENDENT MATURITY'],['Liquid','DIRECTION'],['Spark','DIRECTION']],integrationLabel:'INTEGRATION',implement:'What an integrator connects',implementText:'Adopt the smallest correct surface for the product. The application publishes only the assets, rails and behaviors it can actually execute.',steps:['Install @satsails/p2p-trading-sdk','Declare supported capabilities','Connect wallet and signing adapters','Connect settlement or provider adapters','Map the interface to the trade lifecycle','Validate evidence and failure paths'],controlLabel:'CONTROL STAYS LOCAL',control:'What the application controls',controlText:'Sails defines coordination semantics. The integrating product remains responsible for the surfaces below.',controls:['Custody and keys','Signing policy','Supported assets','Settlement rails','Liquidity sources','Interface and compliance'],boundary:'The SDK is coordination infrastructure. It does not become any of these systems.',nots:['NOT A WALLET','NOT AN EXCHANGE','NOT A BANK','NOT A LIQUIDITY PROVIDER','NOT A SETTLEMENT RAIL','NOT A NEW BLOCKCHAIN'],marketLabel:'OPEN MARKET PARTICIPATION',liquidity:'Make participant liquidity discoverable across compatible markets.',liquidityText:'A conformant wallet or service can publish and discover compatible opportunities across participating surfaces. Participants and providers supply the liquidity. Sails gives them a shared language for discovery, negotiation and attributable outcomes.',discovery:'MARKET COORDINATION',nodes:['WALLET','MARKET','FINTECH','WEB','AGENT','PROVIDER'],directionLabel:'RESEARCH / DIRECTION',portable:'Portable history is a protocol direction.',portableText:'The goal is for attributable evidence and reputation context to move with the user across compatible interfaces. This remains a direction under development, not a claim of universal portability today.',close:'Keep the product. Open the market.',closeText:'Start with the current TypeScript implementation and integrate only the capabilities your application can support.',tags:['NON-CUSTODIAL','MODULAR','INTEROPERABLE']
  },
  'pt-BR': {
    eyebrow:'PRIMEIRO PRODUTO PARA DESENVOLVEDORES',status:'ATUAL',package:'PACOTE',title:'Sails P2P Trading SDK',intro:'Adicione coordenação de mercado P2P interoperável a uma wallet, fintech ou plataforma web, preservando chaves, assinatura, opções de liquidação e experiência do usuário.',docs:'Ler documentação',source:'Ver código-fonte',problemLabel:'O PROBLEMA DE MERCADO',problem:'Custódia aberta não cria um mercado aberto.',problemText:'As chaves podem ser portáteis enquanto ofertas, contrapartes, negociação e histórico econômico continuam presos em cada aplicação. Cada produto acaba reconstruindo descoberta, mensageria, evidências e coordenação de liquidação dentro do próprio mercado privado.',isolated:'MERCADO ISOLADO',surfaces:['MERCADO DA WALLET','MERCADO DA FINTECH','MERCADO WEB'],shiftLabel:'O QUE MUDA',shift:'De uma função privada para uma superfície compartilhada de coordenação.',shiftText:'O SDK oferece semânticas econômicas comuns para expressar intenção, descobrir oportunidades compatíveis, negociar termos e coordenar a liquidação fora do protocolo. Cada participante declara apenas o que realmente suporta.',flowLabel:'FLUXO DE COORDENAÇÃO',visualTitle:'Um SDK. Seis estágios explícitos de coordenação.',visualText:'O Sails coordena o ciclo do acordo. Wallets e provedores mantêm custódia, assinatura e execução.',entries:['Wallet','Fintech','Plataforma web'],stages:['Expressar intenção','Descobrir oportunidades','Negociar termos','Combinar capacidades','Coordenar liquidação','Registrar resultados'],demonstrated:'DEMONSTRADO',direction:'DIREÇÃO',rails:[['Bitcoin multisig','DEMONSTRADO'],['WDK USDT EVM','DEMONSTRADO'],['Arkade / VTXO','DEMONSTRADO'],['Lightning','MATURIDADE INDEPENDENTE'],['Liquid','DIREÇÃO'],['Spark','DIREÇÃO']],integrationLabel:'INTEGRAÇÃO',implement:'O que o integrador conecta',implementText:'Adote a menor superfície correta para o produto. A aplicação publica somente os ativos, trilhos e comportamentos que consegue executar.',steps:['Instalar @satsails/p2p-trading-sdk','Declarar capacidades suportadas','Conectar adaptadores de wallet e assinatura','Conectar adaptadores de liquidação ou provedores','Mapear a interface ao ciclo do trade','Validar evidências e caminhos de falha'],controlLabel:'O CONTROLE CONTINUA LOCAL',control:'O que a aplicação controla',controlText:'O Sails define as semânticas de coordenação. O produto integrado continua responsável pelas superfícies abaixo.',controls:['Custódia e chaves','Política de assinatura','Ativos suportados','Trilhos de liquidação','Fontes de liquidez','Interface e conformidade'],boundary:'O SDK é infraestrutura de coordenação. Ele não se transforma em nenhum destes sistemas.',nots:['NÃO É WALLET','NÃO É EXCHANGE','NÃO É BANCO','NÃO É PROVEDOR DE LIQUIDEZ','NÃO É TRILHO DE LIQUIDAÇÃO','NÃO É UMA NOVA BLOCKCHAIN'],marketLabel:'PARTICIPAÇÃO NO MERCADO ABERTO',liquidity:'Torne a liquidez dos participantes descobrível entre mercados compatíveis.',liquidityText:'Uma wallet ou serviço compatível pode publicar e descobrir oportunidades entre superfícies participantes. A liquidez vem dos participantes e provedores. O Sails oferece uma linguagem comum para descoberta, negociação e resultados atribuíveis.',discovery:'COORDENAÇÃO DE MERCADO',nodes:['WALLET','MERCADO','FINTECH','WEB','AGENTE','PROVEDOR'],directionLabel:'PESQUISA / DIREÇÃO',portable:'Histórico portável é uma direção do protocolo.',portableText:'O objetivo é permitir que evidências atribuíveis e contexto de reputação acompanhem o usuário entre interfaces compatíveis. Isso ainda é uma direção em desenvolvimento, não uma promessa de portabilidade universal hoje.',close:'Mantenha o produto. Abra o mercado.',closeText:'Comece pela implementação TypeScript atual e integre somente as capacidades que sua aplicação consegue suportar.',tags:['NÃO CUSTODIAL','MODULAR','INTEROPERÁVEL']
  },
  es: {
    eyebrow:'PRIMER PRODUCTO PARA DESARROLLADORES',status:'ACTUAL',package:'PAQUETE',title:'Sails P2P Trading SDK',intro:'Añade coordinación de mercado P2P interoperable a una wallet, fintech o plataforma web, preservando claves, firma, opciones de liquidación y experiencia de usuario.',docs:'Leer documentación',source:'Ver código fuente',problemLabel:'EL PROBLEMA DE MERCADO',problem:'La custodia abierta no crea un mercado abierto.',problemText:'Las claves pueden ser portátiles mientras las ofertas, contrapartes, negociación e historial económico siguen atrapados en cada aplicación. Cada producto termina reconstruyendo descubrimiento, mensajería, evidencias y coordinación de liquidación dentro de su propio mercado privado.',isolated:'MERCADO AISLADO',surfaces:['MERCADO DE WALLET','MERCADO FINTECH','MERCADO WEB'],shiftLabel:'QUÉ CAMBIA',shift:'De una función privada a una superficie compartida de coordinación.',shiftText:'El SDK ofrece semánticas económicas comunes para expresar intención, descubrir oportunidades compatibles, negociar términos y coordinar la liquidación fuera del protocolo. Cada participante declara solo lo que realmente admite.',flowLabel:'FLUJO DE COORDINACIÓN',visualTitle:'Un SDK. Seis etapas explícitas de coordinación.',visualText:'Sails coordina el ciclo del acuerdo. Wallets y proveedores mantienen custodia, firma y ejecución.',entries:['Wallet','Fintech','Plataforma web'],stages:['Expresar intención','Descubrir oportunidades','Negociar términos','Combinar capacidades','Coordinar liquidación','Registrar resultados'],demonstrated:'DEMOSTRADO',direction:'DIRECCIÓN',rails:[['Bitcoin multisig','DEMOSTRADO'],['WDK USDT EVM','DEMOSTRADO'],['Arkade / VTXO','DEMOSTRADO'],['Lightning','MADUREZ INDEPENDIENTE'],['Liquid','DIRECCIÓN'],['Spark','DIRECCIÓN']],integrationLabel:'INTEGRACIÓN',implement:'Lo que conecta el integrador',implementText:'Adopta la menor superficie correcta para el producto. La aplicación publica solamente los activos, redes y comportamientos que puede ejecutar.',steps:['Instalar @satsails/p2p-trading-sdk','Declarar capacidades compatibles','Conectar adaptadores de wallet y firma','Conectar adaptadores de liquidación o proveedores','Mapear la interfaz al ciclo del trade','Validar evidencias y rutas de fallo'],controlLabel:'EL CONTROL SIGUE SIENDO LOCAL',control:'Lo que controla la aplicación',controlText:'Sails define las semánticas de coordinación. El producto integrado sigue siendo responsable de las superficies siguientes.',controls:['Custodia y claves','Política de firma','Activos compatibles','Redes de liquidación','Fuentes de liquidez','Interfaz y cumplimiento'],boundary:'El SDK es infraestructura de coordinación. No se convierte en ninguno de estos sistemas.',nots:['NO ES WALLET','NO ES EXCHANGE','NO ES BANCO','NO ES PROVEEDOR DE LIQUIDEZ','NO ES RED DE LIQUIDACIÓN','NO ES UNA NUEVA BLOCKCHAIN'],marketLabel:'PARTICIPACIÓN EN EL MERCADO ABIERTO',liquidity:'Haz que la liquidez de los participantes sea descubrible entre mercados compatibles.',liquidityText:'Una wallet o servicio compatible puede publicar y descubrir oportunidades entre superficies participantes. La liquidez proviene de participantes y proveedores. Sails ofrece un lenguaje común para descubrimiento, negociación y resultados atribuibles.',discovery:'COORDINACIÓN DE MERCADO',nodes:['WALLET','MERCADO','FINTECH','WEB','AGENTE','PROVEEDOR'],directionLabel:'INVESTIGACIÓN / DIRECCIÓN',portable:'El historial portátil es una dirección del protocolo.',portableText:'El objetivo es permitir que las evidencias atribuibles y el contexto de reputación acompañen al usuario entre interfaces compatibles. Esto sigue siendo una dirección en desarrollo, no una promesa de portabilidad universal actual.',close:'Mantén el producto. Abre el mercado.',closeText:'Comienza con la implementación TypeScript actual e integra solamente las capacidades que tu aplicación puede admitir.',tags:['NO CUSTODIAL','MODULAR','INTEROPERABLE']
  }
}[lang];
const problemAria = lang==='pt-BR' ? 'Três mercados isolados em aplicações diferentes' : lang==='es' ? 'Tres mercados aislados en aplicaciones diferentes' : 'Three isolated markets in different applications';
---
<BaseLayout lang={lang} title={`${c.title} | Sails Protocol`} description={c.intro}>
  <SiteHeader lang={lang} path="sdks/p2p-trading" />
  <main class="p2p-page">
    <section class="p2p-hero">
      <p class="eyebrow">{c.eyebrow}</p><h1>{c.title}</h1><p>{c.intro}</p>
      <div class="p2p-package"><span>{c.status}</span><small>{c.package}</small><code>@satsails/p2p-trading-sdk</code></div>
      <div class="p2p-actions"><a class="primary" href={`/${lang}/developers/documentation/`}>{c.docs} ↓</a><a href={github} target="_blank" rel="noreferrer">{c.source} ↗</a></div>
      <div class="p2p-tags">{c.tags.map(tag=><span>{tag}</span>)}</div>
    </section>
    <section class="p2p-problem">
      <div><p class="eyebrow">{c.problemLabel}</p><h2>{c.problem}</h2><p>{c.problemText}</p></div>
      <div class="island-visual isolated-only" aria-label={problemAria}>
        {c.surfaces.map((surface,index)=><div class={`island island-${index+1}`}><span>{surface}</span><i></i><small>{c.isolated}</small></div>)}
        <svg viewBox="0 0 640 520" aria-hidden="true"><path d="M80 80L270 218"/><path d="M560 80L370 218"/><path d="M110 440L270 302"/><path d="M320 218v84"/></svg>
        <div class="isolation-mark"><b>×</b><small>{c.isolated}</small></div>
      </div>
    </section>
    <section class="p2p-shift"><p class="eyebrow">{c.shiftLabel}</p><div><h2>{c.shift}</h2><p>{c.shiftText}</p></div></section>
    <section class="p2p-flow">
      <div class="flow-heading"><div><p class="eyebrow">{c.flowLabel}</p><h2>{c.visualTitle}</h2></div><p>{c.visualText}</p></div>
      <div class="sdk-flow-visual revised-flow">
        <div class="flow-entry">{c.entries.map(entry=><article><small>APPLICATION</small><b>{entry}</b></article>)}</div><div class="flow-arrow" aria-hidden="true">→</div>
        <div class="sdk-core"><span>Sails</span><b>P2P Trading SDK</b><div>{c.stages.map((stage,i)=><small><i>0{i+1}</i>{stage}</small>)}</div></div><div class="flow-arrow" aria-hidden="true">→</div>
        <div class="flow-rails">{c.rails.map(([rail,status])=><span><b>{rail}</b><small class:list={{direction:status===c.direction,demonstrated:status===c.demonstrated}}>{status}</small></span>)}</div>
      </div>
    </section>
    <section class="p2p-details">
      <article><p class="eyebrow">{c.integrationLabel}</p><h2>{c.implement}</h2><p>{c.implementText}</p><ol>{c.steps.map(step=><li>{step}</li>)}</ol></article>
      <article><p class="eyebrow">{c.controlLabel}</p><h2>{c.control}</h2><p>{c.controlText}</p><div class="control-list">{c.controls.map(item=><span>{item}</span>)}</div><p class="boundary-note">{c.boundary}</p><div class="not-list">{c.nots.map(item=><span>{item}</span>)}</div></article>
    </section>
    <section class="liquidity-story"><div><p class="eyebrow">{c.marketLabel}</p><h2>{c.liquidity}</h2><p>{c.liquidityText}</p></div><div class="liquidity-network" aria-hidden="true"><b>{c.discovery}</b>{c.nodes.map((name,i)=><span class={`q${i+1}`}>{name}</span>)}<i></i><i></i><i></i></div></section>
    <section class="portable-direction"><p class="eyebrow">{c.directionLabel}</p><div><h2>{c.portable}</h2><p>{c.portableText}</p></div><div class="portable-route" aria-hidden="true"><span>WALLET A</span><i>→</i><b>USER EVIDENCE</b><i>→</i><span>WALLET B</span></div></section>
    <section class="p2p-close"><p>{c.close}</p><small>{c.closeText}</small><div class="p2p-actions"><a href={`/${lang}/developers/documentation/`}>{c.docs} ↓</a><a href={github} target="_blank" rel="noreferrer">GitHub ↗</a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
