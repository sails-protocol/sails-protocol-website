---
import type { Locale } from '../i18n/content';
interface Card { title:string; text:string; status?:string }
interface Props { lang:Locale; path:string; title:string; cards:Card[] }
const { lang, path, title, cards } = Astro.props;
const journeyCards = cards.map((card,index)=>({...card,num:`0${index+1}`,hasNext:index<cards.length-1}));
const t = lang === 'pt-BR' ? {
  visual:'modelo visual', participants:['WALLET','FINTECH','MERCADO WEB'], semantics:['INTENÇÃO','AUTORIDADE','CONDIÇÕES','EVIDÊNCIA','RESULTADO'], coordination:'SEMÂNTICAS SAILS', external:'EXECUÇÃO EXTERNA', independent:'CONTROLE INDEPENDENTE', request:'SOLICITAÇÃO', evidence:'RETORNO DE EVIDÊNCIA',
  applications:'APLICAÇÕES E PRODUTOS', interfaces:'SDKs E INTERFACES', modules:'MÓDULOS ABERTOS', kernel:'KERNEL SEMÂNTICO', providers:'PROVEDORES E TRILHOS EXTERNOS', down:'SOLICITAÇÃO VALIDADA', up:'EVIDÊNCIA ATRIBUÍVEL',
  stable:'SEMÂNTICAS ESTÁVEIS', compose:'COMPÕEM CAPACIDADES', moduleNames:['OpenP2P','OpenSettlement','OpenIdentity','OpenReputation'], products:'PRODUTOS PARA DESENVOLVEDORES', contracts:'CONTRATOS SAILS', providerGroups:['WALLET E ASSINATURA','TRANSPORTE P2P','INTELIGÊNCIA LOCAL','LIQUIDAÇÃO EXTERNA'], maturity:'EVIDÊNCIA E MATURIDADE POR CAMINHO', extensionParts:['ENTRADAS E SAÍDAS','LIMITES DE AUTORIDADE','EVIDÊNCIA EXIGIDA','PROVEDOR SUBSTITUÍVEL'], cannot:'NÃO REDEFINE A VERDADE DO PROTOCOLO', website:'SITE SAILS', tools:'FERRAMENTAS SOMENTE LEITURA', agent:'AGENTE DO NAVEGADOR', noAuthority:'SEM AUTORIDADE FINANCEIRA OU DO PROTOCOLO', nodeFlow:['ENTRADA ACEITA','VALIDAÇÃO DE CONTRATO','EXECUÇÃO DE CAPACIDADE','RETORNO DE EVIDÊNCIA'], operation:'MODELOS DE OPERAÇÃO', operationModels:['INDEPENDENTE: CAMINHO DOCUMENTADO','GERENCIADO: DIREÇÃO','WHITE-LABEL: CONCEITO'], safetyLayers:['CUSTÓDIA EXTERNA','AUTORIZAÇÃO EXPLÍCITA','PROVEDORES LIMITADOS','EVIDÊNCIA ATRIBUÍVEL'], truth:'VERDADE DO PROTOCOLO', same:'MESMAS SEMÂNTICAS ECONÔMICAS', journey:'CAMINHO DE LEITURA', states:'ESTADOS DE INTERFACE', reference:'SUPERFÍCIE DE REFERÊNCIA', canonical:'CONTEXTO E FONTE CANÔNICA', exercises:'EXERCITAM O MESMO PROTOCOLO', doesNotOwn:'NÃO CONTROLA AS SEMÂNTICAS'
} : lang === 'es' ? {
  visual:'modelo visual', participants:['WALLET','FINTECH','MERCADO WEB'], semantics:['INTENCIÓN','AUTORIDAD','CONDICIONES','EVIDENCIA','RESULTADO'], coordination:'SEMÁNTICAS SAILS', external:'EJECUCIÓN EXTERNA', independent:'CONTROL INDEPENDIENTE', request:'SOLICITUD', evidence:'RETORNO DE EVIDENCIA',
  applications:'APLICACIONES Y PRODUCTOS', interfaces:'SDKs E INTERFACES', modules:'MÓDULOS ABIERTOS', kernel:'KERNEL SEMÁNTICO', providers:'PROVEEDORES Y REDES EXTERNAS', down:'SOLICITUD VALIDADA', up:'EVIDENCIA ATRIBUIBLE',
  stable:'SEMÁNTICAS ESTABLES', compose:'COMPONEN CAPACIDADES', moduleNames:['OpenP2P','OpenSettlement','OpenIdentity','OpenReputation'], products:'PRODUCTOS PARA DESARROLLADORES', contracts:'CONTRATOS SAILS', providerGroups:['WALLET Y FIRMA','TRANSPORTE P2P','INTELIGENCIA LOCAL','LIQUIDACIÓN EXTERNA'], maturity:'EVIDENCIA Y MADUREZ POR RUTA', extensionParts:['ENTRADAS Y SALIDAS','LÍMITES DE AUTORIDAD','EVIDENCIA REQUERIDA','PROVEEDOR REEMPLAZABLE'], cannot:'NO REDEFINE LA VERDAD DEL PROTOCOLO', website:'SITIO SAILS', tools:'HERRAMIENTAS DE SOLO LECTURA', agent:'AGENTE DEL NAVEGADOR', noAuthority:'SIN AUTORIDAD FINANCIERA NI DEL PROTOCOLO', nodeFlow:['ENTRADA ACEPTADA','VALIDACIÓN DE CONTRATO','EJECUCIÓN DE CAPACIDAD','RETORNO DE EVIDENCIA'], operation:'MODELOS DE OPERACIÓN', operationModels:['INDEPENDIENTE: RUTA DOCUMENTADA','ADMINISTRADO: DIRECCIÓN','WHITE-LABEL: CONCEPTO'], safetyLayers:['CUSTODIA EXTERNA','AUTORIZACIÓN EXPLÍCITA','PROVEEDORES LIMITADOS','EVIDENCIA ATRIBUIBLE'], truth:'VERDAD DEL PROTOCOLO', same:'MISMAS SEMÁNTICAS ECONÓMICAS', journey:'RUTA DE LECTURA', states:'ESTADOS DE INTERFAZ', reference:'SUPERFICIE DE REFERENCIA', canonical:'CONTEXTO Y FUENTE CANÓNICA', exercises:'EJERCITAN EL MISMO PROTOCOLO', doesNotOwn:'NO CONTROLA LAS SEMÁNTICAS'
} : {
  visual:'visual model', participants:['WALLET','FINTECH','WEB MARKET'], semantics:['INTENT','AUTHORITY','CONDITIONS','EVIDENCE','OUTCOME'], coordination:'SAILS SEMANTICS', external:'EXTERNAL EXECUTION', independent:'INDEPENDENT CONTROL', request:'REQUEST', evidence:'EVIDENCE RETURN',
  applications:'APPLICATIONS AND PRODUCTS', interfaces:'SDKs AND INTERFACES', modules:'OPEN MODULES', kernel:'SEMANTIC KERNEL', providers:'EXTERNAL PROVIDERS AND RAILS', down:'VALIDATED REQUEST', up:'ATTRIBUTABLE EVIDENCE',
  stable:'STABLE SEMANTICS', compose:'COMPOSE CAPABILITIES', moduleNames:['OpenP2P','OpenSettlement','OpenIdentity','OpenReputation'], products:'DEVELOPER PRODUCTS', contracts:'SAILS CONTRACTS', providerGroups:['WALLET AND SIGNING','P2P TRANSPORT','LOCAL INTELLIGENCE','EXTERNAL SETTLEMENT'], maturity:'EVIDENCE AND MATURITY PER PATH', extensionParts:['INPUTS AND OUTPUTS','AUTHORITY BOUNDARIES','REQUIRED EVIDENCE','REPLACEABLE PROVIDER'], cannot:'DOES NOT REDEFINE PROTOCOL TRUTH', website:'SAILS WEBSITE', tools:'READ-ONLY TOOLS', agent:'BROWSER AGENT', noAuthority:'NO FINANCIAL OR PROTOCOL AUTHORITY', nodeFlow:['ACCEPTED INPUT','CONTRACT VALIDATION','CAPABILITY EXECUTION','EVIDENCE RETURN'], operation:'OPERATING MODELS', operationModels:['INDEPENDENT: DOCUMENTED PATH','MANAGED: DIRECTION','WHITE-LABEL: CONCEPT'], safetyLayers:['EXTERNAL CUSTODY','EXPLICIT AUTHORIZATION','BOUNDED PROVIDERS','ATTRIBUTABLE EVIDENCE'], truth:'PROTOCOL TRUTH', same:'SAME ECONOMIC SEMANTICS', journey:'READING PATH', states:'INTERFACE STATES', reference:'REFERENCE SURFACE', canonical:'STRUCTURED CONTEXT AND CANONICAL SOURCE', exercises:'EXERCISE THE SAME PROTOCOL', doesNotOwn:'DOES NOT OWN SEMANTICS'
};
---

{path === 'protocol' ? (
  <section class="specific-diagram protocol-map" aria-label={`${title} ${t.visual}`}>
    <div class="participant-row">{t.participants.map((item,i)=><article><small>0{i+1}</small><b>{item}</b><span>{t.independent}</span></article>)}</div>
    <div class="direction request"><span>{t.request}</span><i></i></div>
    <div class="semantic-core"><small>{t.coordination}</small><div>{t.semantics.map(item=><b>{item}</b>)}</div></div>
    <div class="direction evidence"><i></i><span>{t.evidence}</span></div>
    <div class="external-row"><span>BITCOIN</span><span>LIGHTNING</span><span>LIQUID</span><span>STABLECOINS</span><b>{t.external}</b></div>
  </section>
) : path === 'anatomy' ? (
  <section class="specific-diagram anatomy-stack" aria-label={`${title} ${t.visual}`}>
    <div class="stack-label down-label">↓ {t.down}</div>
    <div class="stack-label up-label">↑ {t.up}</div>
    <article><small>01</small><div><b>{t.applications}</b><span>{cards[0]?.text}</span></div></article>
    <article><small>02</small><div><b>{t.interfaces}</b><span>TypeScript · API · WebMCP · native targets</span></div></article>
    <article><small>03</small><div><b>{t.modules}</b><span>{cards[2]?.text}</span></div></article>
    <article class="kernel-layer"><small>04</small><div><b>{t.kernel}</b><span>{cards[0]?.text}</span></div></article>
    <article><small>05</small><div><b>{cards[3]?.title}</b><span>{cards[3]?.text}</span></div></article>
    <article><small>06</small><div><b>{t.providers}</b><span>{cards[4]?.text}</span></div></article>
  </section>
) : path === 'sdks' ? (
  <section class="specific-diagram sdk-composition" aria-label={`${title} ${t.visual}`}>
    <div class="semantics-root"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><div><small>SAILS PROTOCOL</small><b>{t.stable}</b></div></div>
    <div class="composition-arrow"><span>{t.compose}</span></div>
    <div class="module-band">{t.moduleNames.map((item,i)=><span class:list={{active:i===0}}>{item}</span>)}</div>
    <div class="product-label">{t.products}</div>
    <div class="sdk-products">{cards.map((card,i)=><article class:list={{current:i===0}}><small>{card.status}</small><b>{card.title}</b><span>{i===0?'TypeScript':'Research / Direction'}</span></article>)}</div>
  </section>
) : path === 'integrations' ? (
  <section class="specific-diagram integration-map" aria-label={`${title} ${t.visual}`}>
    <div class="provider-grid">{t.providerGroups.map((group,i)=><article><small>0{i+1}</small><b>{group}</b><span>{cards[i]?.title}</span><em>{cards[i]?.status}</em></article>)}</div>
    <div class="adapter-lines" aria-hidden="true">{t.providerGroups.map(()=><i></i>)}</div>
    <div class="contract-core"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><div><small>SAILS</small><b>{t.contracts}</b></div></div>
    <div class="maturity-band"><b>{t.maturity}</b><span>{cards.slice(4).map(card=>card.title).join(' · ')}</span></div>
  </section>
) : path === 'developers/open-extension' ? (
  <section class="specific-diagram extension-boundary" aria-label={`${title} ${t.visual}`}>
    <div class="extension-kernel"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><small>SAILS</small><b>{t.kernel}</b></div>
    <div class="extension-contracts">{t.extensionParts.map((part,i)=><article><small>0{i+1}</small><b>{part}</b><span>{cards[i]?.status}</span></article>)}</div>
    <div class="truth-boundary">{t.cannot}</div>
  </section>
) : path === 'developers/webmcp' ? (
  <section class="specific-diagram webmcp-flow" aria-label={`${title} ${t.visual}`}>
    <article class="web-surface"><small>01</small><b>{t.website}</b><span>document · metadata · WebMCP</span></article><i>→</i>
    <div class="tool-surface"><small>02 · {t.tools}</small>{cards.map(card=><b>{card.title}</b>)}</div><i>→</i>
    <article class="agent-surface"><small>03</small><b>{t.agent}</b><span>inspect · query · discover</span></article>
    <div class="authority-stop"><span>×</span><b>{t.noAuthority}</b></div>
  </section>
) : path === 'products/sails-node' ? (
  <section class="specific-diagram node-runtime" aria-label={`${title} ${t.visual}`}>
    <div class="runtime-flow">{t.nodeFlow.map((stage,idx)=><Fragment><article class:list={{execution:idx===2}}><small>0{idx+1}</small><b>{stage}</b></article>{idx<3&&<i>→</i>}</Fragment>)}</div>
    <div class="runtime-boundary"><b>SAILS NODE RUNTIME</b><span>{cards.slice(0,3).map(card=>card.title).join(' · ')}</span></div>
    <div class="operation-label">{t.operation}</div><div class="operation-models">{t.operationModels.map((model,i)=><span class:list={{documented:i===0}}>{model}</span>)}</div>
  </section>
) : path === 'safety-center' ? (
  <section class="specific-diagram safety-gates" aria-label={`${title} ${t.visual}`}>
    <div class="safety-track">{t.safetyLayers.map((layer,idx)=><Fragment><article><small>0{idx+1}</small><b>{layer}</b><span>{cards[idx]?.status}</span></article>{idx<3&&<i>→</i>}</Fragment>)}</div>
    <div class="truth-core"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><div><small>SAILS</small><b>{t.truth}</b></div></div>
    <div class="safety-rule">{cards.map(card=>card.title).join(' · ')}</div>
  </section>
) : path === 'developers' ? (
  <section class="specific-diagram developer-surfaces" aria-label={`${title} ${t.visual}`}>
    <div class="surface-columns">{cards.map((card,i)=><article><small>0{i+1}</small><b>{card.title}</b><span>{card.status}</span><p>{card.text}</p></article>)}</div>
    <div class="shared-semantics"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><b>{t.same}</b></div>
  </section>
) : path === 'developers/documentation' ? (
  <section class="specific-diagram docs-journey" aria-label={`${title} ${t.visual}`}>
    <div class="journey-label">{t.journey}</div><div class="journey-track">{journeyCards.map(card=><div class="journey-unit"><article><small>{card.num}</small><b>{card.title}</b><span>{card.status}</span></article>{card.hasNext&&<i>→</i>}</div>)}</div>
    <div class="canonical-destination">GitHub · docs · tests · evidence</div>
  </section>
) : path === 'products/ui-kit' ? (
  <section class="specific-diagram ui-storyboard" aria-label={`${title} ${t.visual}`}>
    <div class="story-label">{t.states}</div><div class="screen-row">{cards.map((card,idx)=><article><header><i></i><i></i><i></i></header><small>0{idx+1}</small><b>{card.title}</b><div><span></span><span></span><span></span></div></article>)}</div>
    <div class="direction-banner">RESEARCH / DIRECTION</div>
  </section>
) : path === 'products/sails-market' ? (
  <section class="specific-diagram market-reference" aria-label={`${title} ${t.visual}`}>
    <div class="market-participants"><span>WALLET</span><span>FINTECH</span><span>WEB</span></div><div class="market-arrows">↓ &nbsp; ↓ &nbsp; ↓</div>
    <div class="market-surface"><small>{t.reference}</small><b>SAILS MARKET</b><div>{cards.map(card=><span>{card.title}</span>)}</div></div>
    <div class="market-execution"><span>BITCOIN</span><span>STABLECOINS</span><span>EXTERNAL PROVIDERS</span></div>
  </section>
) : path === 'explore-ai' ? (
  <section class="specific-diagram ai-context" aria-label={`${title} ${t.visual}`}>
    <div class="assistant-grid">{cards.map((card,idx)=><article><i>{['C','◉','✦','G'][idx]}</i><div><b>{card.title}</b><small>{card.status}</small></div></article>)}</div>
    <div class="context-bridge">↔</div><div class="source-context"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><small>SAILS</small><b>{t.canonical}</b><span>docs · GitHub · WebMCP</span></div>
  </section>
) : path === 'case-studies' ? (
  <section class="specific-diagram case-pair" aria-label={`${title} ${t.visual}`}>
    <div class="case-products">{cards.map((card,i)=><article><small>0{i+1} · {card.status}</small><b>{card.title}</b><p>{card.text}</p></article>)}</div>
    <div class="case-connection"><span>{t.exercises}</span><i></i></div><div class="case-protocol"><img class="brand-symbol" src="/brand/sails-simbolo-cor-escuro.svg" alt="" /><b>SAILS PROTOCOL</b><small>{t.doesNotOwn}</small></div>
  </section>
) : (
  <section class="specific-diagram unsupported-visual" aria-label={`${title} ${t.visual}`}><b>SAILS PROTOCOL</b></section>
)}

<style>
  .specific-diagram{position:relative;margin:0 max(22px,6vw) 125px;border:1px solid var(--line);background:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px),#0d131a;background-size:42px 42px;overflow:hidden}
  .protocol-map{min-height:690px;padding:54px 6%;display:grid;grid-template-rows:auto 50px 1fr 50px auto;gap:14px}
  .participant-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.participant-row article{padding:17px;border:1px solid var(--line);background:var(--surface);display:grid;grid-template-columns:auto 1fr;gap:7px 12px}.participant-row small{grid-row:1/3;color:var(--blue);font-size:8px}.participant-row b{font-size:12px}.participant-row span{color:var(--muted);font-size:7px}
  .direction{display:flex;align-items:center;justify-content:center;gap:12px;color:var(--muted);font-size:7px;font-weight:800;letter-spacing:.12em}.direction i{width:1px;height:34px;background:linear-gradient(var(--blue),var(--orange));position:relative}.direction i:after{content:"";position:absolute;bottom:0;left:-3px;width:6px;height:6px;border-right:1px solid var(--orange);border-bottom:1px solid var(--orange);transform:rotate(45deg)}.evidence i{transform:rotate(180deg)}
  .semantic-core{align-self:center;padding:28px;border:1px solid var(--orange);background:rgba(255,138,22,.06);box-shadow:0 0 50px rgba(255,138,22,.08)}.semantic-core>small{display:block;margin-bottom:20px;color:var(--orange);font-size:9px;font-weight:800;letter-spacing:.14em}.semantic-core>div{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.semantic-core b{padding:16px 8px;border:1px solid var(--line);background:var(--canvas);font-size:8px;text-align:center}
  .external-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.external-row span{padding:13px;border:1px solid var(--line);background:var(--surface);color:var(--muted);font-size:8px;text-align:center}.external-row b{grid-column:1/-1;color:var(--orange);font-size:8px;letter-spacing:.13em;text-align:center}
  .anatomy-stack{min-height:760px;padding:54px 13%}.anatomy-stack article{position:relative;min-height:92px;margin-bottom:13px;padding:18px 20px;border:1px solid var(--line);background:rgba(23,33,44,.94);display:grid;grid-template-columns:42px 1fr;align-items:center}.anatomy-stack article:after{content:"";position:absolute;bottom:-14px;left:50%;width:1px;height:13px;background:var(--blue)}.anatomy-stack article:last-child:after{display:none}.anatomy-stack article>small{color:var(--blue);font-size:8px}.anatomy-stack article div{display:flex;flex-direction:column;gap:7px}.anatomy-stack b{font-size:14px}.anatomy-stack span{color:var(--muted);font-size:9px}.anatomy-stack .kernel-layer{border-color:var(--orange);background:linear-gradient(90deg,rgba(255,138,22,.13),rgba(23,33,44,.94));box-shadow:0 0 35px rgba(255,138,22,.08)}.anatomy-stack .kernel-layer small{color:var(--orange)}.stack-label{position:absolute;top:50%;writing-mode:vertical-rl;color:var(--muted);font-size:7px;font-weight:800;letter-spacing:.11em}.down-label{left:5%;transform:translateY(-50%)}.up-label{right:5%;transform:translateY(-50%) rotate(180deg);color:var(--orange)}
  .sdk-composition{min-height:690px;padding:62px 7%;display:flex;flex-direction:column;align-items:stretch}.semantics-root{align-self:center;min-width:300px;padding:18px 25px;border:1px solid var(--orange);background:var(--surface);display:flex;align-items:center;gap:14px}.semantics-root small{display:block;color:var(--muted);font-size:7px}.semantics-root b{display:block;margin-top:5px;font-size:14px}.composition-arrow{height:90px;display:flex;align-items:center;justify-content:center}.composition-arrow:before{content:"";width:1px;height:70px;background:linear-gradient(var(--orange),var(--blue))}.composition-arrow span{margin-left:13px;color:var(--muted);font-size:7px;letter-spacing:.1em}.module-band{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.module-band span{padding:16px;border:1px solid var(--line);background:var(--surface);color:var(--muted);font-size:9px;text-align:center}.module-band .active{border-color:var(--orange);color:var(--orange)}.product-label{margin:45px 0 13px;color:var(--blue);font-size:8px;font-weight:800;letter-spacing:.13em}.sdk-products{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.sdk-products article{min-height:150px;padding:17px;border:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column}.sdk-products small{color:var(--muted);font-size:7px}.sdk-products b{margin:auto 0 8px;font-size:14px}.sdk-products span{color:var(--muted);font-size:8px}.sdk-products .current{border-color:var(--orange);background:rgba(255,138,22,.08)}.sdk-products .current small,.sdk-products .current span{color:var(--orange)}
  .integration-map{min-height:690px;padding:55px 7%;display:grid;grid-template-rows:auto 85px 1fr auto;align-items:center}.provider-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.provider-grid article{min-height:145px;padding:15px;border:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column}.provider-grid small{color:var(--blue);font-size:8px}.provider-grid b{margin:20px 0 8px;font-size:10px}.provider-grid span{font-size:12px}.provider-grid em{margin-top:auto;color:var(--muted);font-size:7px;font-style:normal}.adapter-lines{height:85px;display:grid;grid-template-columns:repeat(4,1fr)}.adapter-lines i{justify-self:center;width:1px;height:100%;background:linear-gradient(var(--blue),var(--orange))}.contract-core{justify-self:center;min-width:280px;padding:20px 25px;border:1px solid var(--orange);background:var(--surface);display:flex;align-items:center;gap:15px;box-shadow:0 0 45px rgba(255,138,22,.1)}.contract-core small{display:block;color:var(--muted);font-size:7px}.contract-core b{display:block;margin-top:5px;font-size:15px}.maturity-band{margin-top:45px;padding:15px;border:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:8px}.maturity-band b{color:var(--orange)}
