---
import InnerPage from '../../components/InnerPage.astro';
import { locales, type Locale } from '../../i18n/content';
import { getPage, pageSlugs } from '../../i18n/pages';
export function getStaticPaths(){return locales.flatMap(lang=>pageSlugs.map(slug=>({params:{lang,slug}})))}
const lang=Astro.params.lang as Locale;
const page=getPage(Astro.params.slug!,lang)!;
---
<InnerPage lang={lang} {...page}/>
