---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { locales, type Locale } from '../../../i18n/content';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}))}
const lang=Astro.params.lang as Locale;
const t = lang==='pt-BR' ? {eyebrow:'PORTAL SAILS',title:'Construa e opere com o Sails.',text:'Acesse o ambiente para explorar Open Extensions, configurar Sails Nodes e gerenciar sua organização.',google:'Continuar com Google',github:'Continuar com GitHub',note:'Integração de autenticação em desenvolvimento. Esta tela demonstra o fluxo e o ambiente planejados.',terms:'Ao continuar, você concorda com os termos e a política de privacidade quando forem publicados.'} : lang==='es' ? {eyebrow:'PORTAL SAILS',title:'Construye y opera con Sails.',text:'Accede al entorno para explorar Open Extensions, configurar Sails Nodes y administrar tu organización.',google:'Continuar con Google',github:'Continuar con GitHub',note:'Integración de autenticación en desarrollo. Esta pantalla demuestra el flujo y el entorno planificados.',terms:'Al continuar, aceptas los términos y la política de privacidad cuando sean publicados.'} : {eyebrow:'SAILS PORTAL',title:'Build and operate with Sails.',text:'Access the environment to explore Open Extensions, configure Sails Nodes and manage your organization.',google:'Continue with Google',github:'Continue with GitHub',note:'Authentication integration is in development. This screen demonstrates the planned flow and environment.',terms:'By continuing, you agree to the terms and privacy policy when they are published.'};
---
<BaseLayout lang={lang} title={`${t.title} | Sails Portal`} description={t.text}>
  <SiteHeader lang={lang} path="portal/login" />
  <main class="portal-login"><section class="login-intro"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p>{t.text}</p><div class="portal-capabilities"><span>OPEN EXTENSION</span><span>SAILS NODE</span><span>ANALYTICS</span><span>TEAM</span></div></section><section class="login-card"><div class="login-brand"><span class="mark"><i></i><i></i></span><div><b>SAILS</b><small>OPERATOR PORTAL</small></div></div><h2>Get started</h2><p>{t.text}</p><a class="oauth google" href={`/${lang}/portal/dashboard/?provider=google`}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.3c1.9-1.8 2.9-4.4 2.9-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.5c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.5 14a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9.1L6.5 14Z"/><path fill="#EA4335" d="M12 6.1c1.5 0 2.8.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 3.1 7.5l3.4 2.7A5.9 5.9 0 0 1 12 6.1Z"/></svg>{t.google}</a><a class="oauth github-oauth" href={`/${lang}/portal/dashboard/?provider=github`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z"/></svg>{t.github}</a><div class="auth-status"><i></i><span>{t.note}</span></div><small class="login-terms">{t.terms}</small></section></main>
  <SiteFooter />
</BaseLayout>
