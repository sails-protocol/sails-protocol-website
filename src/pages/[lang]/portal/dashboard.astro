---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../../i18n/content';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}))}
const lang=Astro.params.lang as Locale;
const t = lang==='pt-BR' ? {overview:'Visão geral',welcome:'Bem-vindo ao ambiente de operação Sails.',text:'Explore capacidades, desenhe uma Open Extension e escolha como executar seu Sails Node.',extensions:'Open Extensions disponíveis',node:'Sails Node',docs:'Documentação',analytics:'Analytics',settings:'Configurações',team:'Equipe',self:'Hospedar meu próprio node',managed:'Configurar node gerenciado',white:'Solicitar white-label',soon:'EM DESENVOLVIMENTO'} : lang==='es' ? {overview:'Visión general',welcome:'Bienvenido al entorno de operación Sails.',text:'Explora capacidades, diseña una Open Extension y elige cómo ejecutar tu Sails Node.',extensions:'Open Extensions disponibles',node:'Sails Node',docs:'Documentación',analytics:'Analytics',settings:'Configuración',team:'Equipo',self:'Alojar mi propio nodo',managed:'Configurar nodo administrado',white:'Solicitar white-label',soon:'EN DESARROLLO'} : {overview:'Overview',welcome:'Welcome to the Sails operating environment.',text:'Explore capabilities, design an Open Extension and choose how to run your Sails Node.',extensions:'Available Open Extensions',node:'Sails Node',docs:'Documentation',analytics:'Analytics',settings:'Settings',team:'Team',self:'Host my own node',managed:'Configure managed node',white:'Request white-label',soon:'IN DEVELOPMENT'};
const menu=[['⌂',t.overview],['◇',t.extensions],['◎',t.node],['≡',t.docs],['⌁',t.analytics],['⚙',t.settings],['＋',t.team]];
---
<BaseLayout lang={lang} title={`${t.overview} | Sails Portal`} description={t.text}>
  <main class="portal-shell"><aside class="portal-sidebar"><a class="portal-brand" href={`/${lang}/`}><span class="mark"><i></i><i></i></span><div><b>SAILS</b><small>OPERATOR PORTAL</small></div></a><nav>{menu.map(([icon,label],i)=><a class:list={{active:i===0}} href={`#${i}`}><span>{icon}</span>{label}</a>)}</nav><div class="portal-user"><i>AS</i><div><b>Workspace</b><small>Preview access</small></div></div></aside><section class="portal-main"><header><div><small>SAILS PORTAL / {t.overview.toUpperCase()}</small><h1>{t.welcome}</h1><p>{t.text}</p></div><a href={`/${lang}/`}>View website ↗</a></header><div class="portal-stats"><article><small>WORKSPACE</small><b>01</b><span>Active environment</span></article><article><small>OPEN EXTENSIONS</small><b>08</b><span>Capability directions</span></article><article><small>NODES</small><b>00</b><span>Not configured</span></article></div><section class="portal-panel"><div><p class="eyebrow">{t.extensions}</p><h2>Compose capabilities through explicit contracts.</h2></div><div class="extension-list">{['OpenP2P','OpenSettlement','OpenIdentity','OpenReputation'].map((name,i)=><article><span>0{i+1}</span><b>{name}</b><small>{i===0?'AVAILABLE PATH':t.soon}</small></article>)}</div></section><section class="portal-panel node-config"><div><p class="eyebrow">{t.node}</p><h2>Choose your operating model.</h2></div><div class="node-choice"><a href="#self"><small>SELF-HOSTED</small><b>{t.self}</b><span>Deploy on infrastructure you control.</span></a><a href="#managed"><small>MANAGED</small><b>{t.managed}</b><span>Guided deployment and observability.</span></a><a href="#white"><small>WHITE-LABEL</small><b>{t.white}</b><span>Branded environment and managed operation.</span></a></div></section></section></main>
</BaseLayout>
