---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProtocolDiagram from '../../components/ProtocolDiagram.astro';
import { copy, locales, type Locale } from '../../i18n/content';

export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const t = copy[lang] ?? copy.en;
const futureSdks = ['Settlement SDK', 'Identity SDK', 'Agents SDK'];
const roadmap = [
  ['01', 'Protocol Foundation', t.current],
  ['02', 'P2P Trading SDK', t.current],
  ['03', 'Open Market Coordination', t.development],
  ['04', 'Portable Identity & Reputation', t.development],
  ['05', 'Open Agents', t.demonstrated],
  ['06', 'Expanded SDK Family', t.direction],
];
---
<BaseLayout lang={lang} title={`${t.title} — Economic Coordination Protocol`} description={t.bigIdea}>
  <header class="glass-nav">
    <a class="brand" href={`/${lang}/`}><span class="mark"><i></i><i></i></span><b>SAILS</b><small>PROTOCOL</small></a>
    <nav><a href={`/${lang}/`}>Home</a><a href={`/${lang}/sdks/`}>SDK</a><a href={`/${lang}/case-studies/`}>{lang==='pt-BR'?'Casos de estudo':lang==='es'?'Casos de estudio':'Case studies'}</a><a href={`https://sails-protocol-blog.netlify.app/${lang}/`}>Blog</a><a href={`/${lang}/safety-center/`}>Safety Center</a></nav>
    <div class="nav-actions">
      <div class="locale" aria-label="Language selector">
        {locales.map(locale => <a class:list={{ active: locale === lang }} href={`/${locale}/`}>{locale === 'pt-BR' ? 'PT' : locale.toUpperCase()}</a>)}
      </div>
      <a class="github" href="https://github.com/alan-schramm/Sails-Protocol">{t.github} ↗</a>
    </div>
  </header>

  <main>
    <section class="hero" id="protocol">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}<em>Economic Coordination Protocol</em></h1>
        <p class="lead">Open infrastructure for building interoperable P2P financial marketplaces.</p>
        <p>{t.hero}</p>
        <div class="actions"><a href="#anatomy">{t.explore} ↓</a><a href="#sdks">{t.p2p} ↗</a></div>
      </div>
      <div class="market-orbit" aria-label="Animated open market coordination diagram">
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <circle class="ring r1" cx="300" cy="300" r="220"/><ellipse class="ring r2" cx="300" cy="300" rx="245" ry="120"/><ellipse class="ring r3" cx="300" cy="300" rx="125" ry="250"/>
          <path class="route" d="M105 190C220 50 390 70 495 185S520 430 390 505 125 460 100 315 170 170 300 300 460 410 495 185"/>
          <circle class="packet packet-orange" r="7"><animateMotion dur="8s" repeatCount="indefinite" path="M105 190C220 50 390 70 495 185S520 430 390 505 125 460 100 315 170 170 300 300 460 410 495 185"/></circle>
          <circle class="packet packet-blue" r="6"><animateMotion dur="10s" begin="-2s" repeatCount="indefinite" path="M495 185C390 70 220 50 105 190S80 430 210 505 475 460 500 315 430 170 300 300 140 410 105 190"/></circle>
          <circle class="packet packet-green" r="5"><animateMotion dur="12s" begin="-5s" repeatCount="indefinite" path="M300 50C470 80 520 230 440 350S210 530 120 400 110 130 300 50"/></circle>
          <circle class="packet packet-violet" r="5"><animateMotion dur="9s" begin="-4s" repeatCount="indefinite" path="M90 300C130 120 350 80 500 210S480 500 300 520 70 450 90 300"/></circle>
          <circle class="packet packet-white" r="4"><animateMotion dur="7s" begin="-3s" repeatCount="indefinite" path="M300 90C190 140 170 330 300 510 430 330 410 140 300 90"/></circle>
        </svg>
        <div class="sails-core"><span class="mark"><i></i><i></i></span><b>SAILS</b><small>economic semantics</small></div>
        <span class="node n1">WALLET</span><span class="node n2">MARKET</span><span class="node n3">AGENT</span><span class="node n4">RAIL</span>
      </div>
      <div class="manifest"><span>NO TOKEN</span><span>NO DAO</span><span>NO NEW BLOCKCHAIN</span><strong>{t.mantra}</strong></div>
    </section>

    <section class="ai-explore" aria-labelledby="ai-title">
      <div><p class="eyebrow">EXPLORE WITH AI</p><h2 id="ai-title">{lang==='pt-BR'?'Explore o Sails com o assistente que você já usa.':lang==='es'?'Explora Sails con el asistente que ya utilizas.':'Explore Sails with the assistant you already use.'}</h2><p>{lang==='pt-BR'?'Contexto estruturado a partir da documentação e do código do protocolo.':lang==='es'?'Contexto estructurado a partir de la documentación y el código del protocolo.':'Structured context drawn from protocol documentation and source.'}</p></div>
      <div class="ai-tools"><a href={`/${lang}/explore-ai/`}><b>Claude</b><span>IN DEVELOPMENT</span></a><a href={`/${lang}/explore-ai/`}><b>Codex</b><span>AVAILABLE PATH</span></a><a href={`/${lang}/explore-ai/`}><b>Gemini</b><span>COMING SOON</span></a><a href={`/${lang}/explore-ai/`}><b>Grok</b><span>COMING SOON</span></a></div>
    </section>

    <section class="problem">
      <p class="eyebrow">01 — {t.problemLabel}</p>
      <div class="split"><h2>{t.problemTitle}</h2><div><p>{t.problem}</p><strong>{t.coordination}</strong></div></div>
      <blockquote>Your keys may be portable.<br/><em>Your economic history usually isn’t.</em></blockquote>
    </section>

    <section class="anatomy" id="anatomy">
      <div class="section-copy"><p class="eyebrow">02 — {t.anatomyLabel}</p><h2>{t.anatomyTitle}</h2><p>{t.anatomyText}</p><a href={`/${lang}/anatomy/`}>Explore the whole anatomy →</a></div>
      <ProtocolDiagram />
    </section>

    <section class="sdks" id="sdks">
      <p class="eyebrow">03 — {t.sdkLabel}</p><div class="split"><h2>{t.sdkTitle}</h2><p>{t.sdkText}</p></div>
      <div class="sdk-grid">
        <article class="sdk active"><div><span>01</span><b>{t.sdkStatus}</b></div><h3>{t.p2p}</h3><p>{t.p2pText}</p><ul><li>Intent & discovery</li><li>Negotiation</li><li>Capability matching</li><li>Evidence & outcomes</li></ul><a href={`/${lang}/sdks/p2p-trading/`}>Explore SDK →</a></article>
        {futureSdks.map((sdk, i) => <article class="sdk soon"><div><span>0{i+2}</span><b>{t.soon}</b></div><h3>{sdk}</h3><p>Focused capability surface. Final scope follows protocol evidence and release governance.</p><span class="lock">＋</span></article>)}
      </div>
      <p class="principle">Different languages. Different interfaces. <strong>Same economic semantics.</strong></p>
    </section>

    <section class="modules-family" id="modules">
      <div class="modules-intro"><p class="eyebrow">04 — PROTOCOL MODULES</p><h2>{lang==='pt-BR'?'Módulos organizam capacidades. SDKs entregam produtos para desenvolvedores.':lang==='es'?'Los módulos organizan capacidades. Los SDKs entregan productos para desarrolladores.':'Modules organize capabilities. SDKs deliver developer products.'}</h2><p>{lang==='pt-BR'?'Um SDK pode combinar vários módulos. Um módulo não representa automaticamente um produto ou pacote independente.':lang==='es'?'Un SDK puede combinar varios módulos. Un módulo no representa automáticamente un producto o paquete independiente.':'One SDK may compose several modules. A module does not automatically represent a standalone product or package.'}</p></div>
      <div class="module-family-grid">{[['OpenP2P','Trade coordination','CURRENT'],['OpenSettlement','Settlement capabilities','DEMONSTRATED'],['OpenIdentity','Participants & control','DEMONSTRATED'],['OpenReputation','Attributable history','IN DEVELOPMENT'],['OpenProof','Evidence & claims','IN DEVELOPMENT'],['OpenLiquidity','Offers & discovery','IN DEVELOPMENT'],['OpenAgents','Bounded agents','RESEARCH'],['OpenFinance','Future coordination','RESEARCH']].map((m,i)=><article class:list={{primary:i===0}}><span>0{i+1}</span><small>{m[2]}</small><h3>{m[0]}</h3><p>{m[1]}</p></article>)}</div>
      <div class="module-rule"><span>PRIMITIVE</span><b>≠</b><span>MODULE</span><b>≠</b><span>PROVIDER</span><b>≠</b><span>PRODUCT</span></div>
    </section>

    <section class="roadmap" id="roadmap">
      <p class="eyebrow">05 — {t.roadmapLabel}</p><h2>{t.roadmapTitle}</h2><div class="status-key"><span>{t.current}</span><span>{t.demonstrated}</span><span>{t.development}</span><span>{t.direction}</span></div>
      <div class="roadmap-line">{roadmap.map((item, i) => <article class:list={{ live: i < 2 }}><span>{item[0]}</span><div><h3>{item[1]}</h3><small>{item[2]}</small></div></article>)}</div>
      <p class="reality">{t.reality}. <strong>The roadmap expands capabilities without changing the meaning of the protocol.</strong></p><a class="more-link" href={`/${lang}/roadmap/`}>{lang==='pt-BR'?'Ver roadmap completo':lang==='es'?'Ver roadmap completo':'View full roadmap'} →</a>
    </section>
  </main>
  <footer><b>SAILS PROTOCOL</b><p>{t.bigIdea}</p><div class="socials"><a aria-label="X" href="https://x.com/">𝕏</a><a aria-label="LinkedIn" href="https://www.linkedin.com/">in</a><a class="github-social" href="https://github.com/sails-protocol/sails-protocol-website"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.4 11.4 0 0 0 12 .8Z"/></svg>GitHub</a></div></footer>
</BaseLayout>
